# ===== Devin =====
# Get from https://app.devin.ai → Settings → API Keys
DEVIN_API_KEY=apk_xxxxxxxxxxxxxxxxxxxxxxxx
DEVIN_API_BASE=https://api.devin.ai/v1

# ===== GitHub =====
# Personal access token with `repo`, `workflow`, `admin:repo_hook` scopes
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx
# The forked repo Devin will work on
GITHUB_REPO=thesaltree/superset
# Random secret used to verify GitHub webhook signatures (any long string)
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ===== Automation tuning =====
MAX_CONCURRENT_WORKERS=3
WORKER_LABEL=devin-task
